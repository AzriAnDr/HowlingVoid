/datum/species/nabber/get_scream_sound(mob/living/carbon/human/nabber)
	return 'modularhowling_void/modules/modular_species/species/GBS/modules/species/nabbers/sounds/nabberscream.ogg'

/datum/laugh_type/nabber
	name = "Ascent Laugh"
	male_laughsounds = list('modularhowling_void/modules/modular_species/species/GBS/modules/species/nabbers/sounds/nabberlaugh.ogg')
	female_laughsounds = null


/datum/scream_type/nabber
	name = "Ascent Scream"
	male_screamsounds = list('modularhowling_void/modules/modular_species/species/GBS/modules/species/nabbers/sounds/nabberscream.ogg')
	female_screamsounds = null
