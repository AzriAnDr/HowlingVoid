/datum/species/nabber/get_scream_sound(mob/living/carbon/human/nabber)
	return 'sound/mobs/humanoids/nabber/nabberscream.ogg'

/datum/laugh_type/nabber
	name = "Ascent Laugh"
	male_laughsounds = list('sound/mobs/humanoids/nabber/nabberlaugh.ogg')
	female_laughsounds = null


/datum/scream_type/nabber
	name = "Ascent Scream"
	male_screamsounds = list('sound/mobs/humanoids/nabber/nabberscream.ogg')
	female_screamsounds = null
