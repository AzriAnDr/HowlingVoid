/datum/action/cooldown/spell/touch/mansus_grasp
	name_ru = "Хватка Мансуса"
	desc_ru = "Касание, позволяющее провести через свою руку силу Древних Богов."

/datum/action/cooldown/spell/realignment
	name_ru = "Перестройка"
	desc_ru = "Перестраивает ваше тело: быстро восстанавливает выносливость и даёт иммунитет к оглушениям, нокдауну, сну и замедлениям. При активации снимает все ограничения с ног и не даёт наложить новые. Пока действует, атаковать нельзя. Можно применять несколько раз подряд, но каждое применение увеличивает перезарядку."

/datum/action/cooldown/spell/jaunt/ethereal_jaunt/ash
	name_ru = "Пепельный Переход"
	desc_ru = "Короткий фазовый рывок, позволяющий беспрепятственно пройти сквозь стену."

/datum/action/cooldown/spell/jaunt/ethereal_jaunt/ash/long
	name_ru = "Пепельная Прогулка"
	desc_ru = "Дальняя фазовая прогулка, позволяющая пройти сквозь несколько стен подряд."

/datum/action/cooldown/spell/pointed/blood_siphon
	name_ru = "Кровавый Сифон"
	desc_ru = "Направленное заклинание, которое лечит ваши раны, одновременно повреждая цель. Особенно эффективно против кровоточащих врагов."

/datum/action/cooldown/spell/pointed/cleave
	name_ru = "Рассечение"
	desc_ru = "Вызывает сильное кровотечение у цели и нескольких существ вокруг неё."

/datum/action/cooldown/spell/pointed/cleave/long
	name_ru = "Малое Рассечение"
	desc_ru = "Ослабленная версия Рассечения с увеличенной дальностью."

/datum/action/cooldown/spell/pointed/crimson_cleave
	name_ru = "Багровое Рассечение"
	desc_ru = "Направленное заклинание, которое лечит вас, раня врага и всё рядом с ним. После применения закрывает ваши раны."

/datum/action/cooldown/spell/conjure/cosmic_expansion
	name_ru = "Космическое Расширение"
	desc_ru = "Создаёт вокруг вас область 5x5 из космических полей. Помеченные звёздой цели не могут добровольно пересекать их."

/datum/action/cooldown/spell/cosmic_rune
	name_ru = "Космическая Руна"
	desc_ru = "Создаёт под вами космическую руну. Одновременно могут существовать только две; активация одной мгновенно переносит к другой. Также может убирать уже созданные руны или переносить вас к Звездочёту."

/datum/action/cooldown/spell/touch/star_touch
	name_ru = "Звёздное Касание"
	desc_ru = "Накладывает на жертву звёздную метку и создаёт рядом с вами космические поля. Если цель уже отмечена, усыпляет её. Может убрать Космические Руны или перенести вас к Звездочёту."

/datum/action/cooldown/spell/pointed/projectile/star_blast
	name_ru = "Звёздный Взрыв"
	desc_ru = "Выпускает сгусток космической энергии, который распространяет звёздную метку, оставляет после себя космические поля и сбивает жертв с ног."

/datum/action/cooldown/spell/pointed/void_phase
	name_ru = "Фазовый Прыжок Пустоты"
	desc_ru = "Дальний телепорт по выбранной точке. При выходе создаёт вокруг вас область урона 3x3 и накладывает пустотный холод."

/datum/action/cooldown/spell/pointed/void_prison
	name_ru = "Тюрьма Пустоты"
	desc_ru = "Запечатывает нечестивца в пустоте на 10 секунд. Пока цель внутри, она не может действовать, говорить или выбраться сама."

/datum/action/cooldown/spell/aoe/void_pull
	name_ru = "Притяжение Пустоты"
	desc_ru = "Призывает пустоту, притягивая ближайших врагов, раня их, сбивая с ног и ненадолго оглушая."

/datum/action/cooldown/spell/conjure/void_conduit
	name_ru = "Проводник Пустоты"
	desc_ru = "Открывает врата в Пустоту, периодически испускающие импульсы, которые повреждают окна и шлюзы, охлаждают врагов и защищают еретиков от низкого давления."

/datum/action/cooldown/spell/cone/staggered/cone_of_cold/void
	name_ru = "Пустотный Взрыв"
	desc_ru = "Выбрасывает перед вами конус леденящей пустоты, замораживая всё на своём пути и накладывая пустотный холод."

/datum/action/cooldown/spell/aoe/rust_conversion
	name_ru = "Агрессивное Распространение"
	desc_ru = "Распространяет ржавчину на ближайшие поверхности."

/datum/action/cooldown/spell/aoe/rust_conversion/construct
	name_ru = "Распространение Конструкта"
	desc_ru = "Ослабленная версия Распространения Ржавчины, доступная вашим созданным существам."

/datum/action/cooldown/spell/cone/staggered/entropic_plume
	name_ru = "Энтропийный Шлейф"
	desc_ru = "Выбрасывает дезориентирующее облако ржавчины, заставляя врагов путаться, блевать и нападать друг на друга."

/datum/action/cooldown/spell/basic_projectile/rust_wave
	name_ru = "Длань Покровителя"
	desc_ru = "Направляет энергию в ваши руки и выпускает волну ржавчины по цели."

/datum/action/cooldown/spell/basic_projectile/rust_wave/short
	name_ru = "Малая Длань Покровителя"
	desc_ru = "Ближняя версия волны ржавчины."

/datum/action/cooldown/mob_cooldown/charge/rust
	name_ru = "Ржавый Рывок"
	desc_ru = "Рывок, который можно начать только с ржавой плитки. Разрушает заржавевшие объекты на пути и ранит всё, во что вы врезаетесь."

/datum/action/cooldown/spell/pointed/rust_construction
	name_ru = "Ржавое Построение"
	desc_ru = "Преобразует заржавевший пол в полноценную ржавую стену. Если создать стену под существом, оно получит урон."

/datum/action/cooldown/spell/pointed/burglar_finesse
	name_ru = "Воровская Ловкость"
	desc_ru = "Крадёт случайный предмет из рюкзака жертвы."

/datum/action/cooldown/spell/caretaker
	name_ru = "Последнее Пристанище Смотрителя"
	desc_ru = "Переводит вас в Пристанище Смотрителя, делая полупрозрачным и неосязаемым. Внутри движение ничем не ограничено, но использовать руки и колдовать нельзя. Нельзя войти в убежище рядом с другими разумными существами; антимагия способна выбросить вас обратно."

/datum/action/cooldown/spell/jaunt/mirror_walk
	name_ru = "Зеркальная Поступь"
	desc_ru = "Позволяет невидимо и свободно перемещаться по станции через зеркальное измерение. Для входа и выхода нужна ближайшая отражающая поверхность."

/datum/action/cooldown/spell/shadow_cloak
	name_ru = "Плащ Тени"
	desc_ru = "Полностью скрывает вашу личность, но не делает невидимым. Может быть отключён досрочно. Пока действует, вы быстрее двигаетесь и не можете взаимодействовать с предметами или колдовать."

/datum/action/innate/expand_sight
	name_ru = "Расширенный Взор"
	desc_ru = "Сильно увеличивает дальность зрения, позволяя замечать врагов с большого расстояния."

/datum/action/cooldown/spell/pointed/projectile/furious_steel
	name_ru = "Яростная Сталь"
	desc_ru = "Призывает три серебряных клинка, вращающихся вокруг вас. Пока они активны, следующая входящая атака будет отражена, а клинки можно метнуть пустой рукой."

/datum/action/cooldown/spell/pointed/projectile/furious_steel/solo
	name_ru = "Малая Яростная Сталь"
	desc_ru = "Призывает один защитный клинок."

/datum/action/cooldown/spell/pointed/projectile/furious_steel/haunted
	name_ru = "Проклятая Сталь"
	desc_ru = "Призывает два проклятых клинка, вращающихся вокруг вас и блокирующих входящие атаки."

/datum/action/cooldown/spell/pointed/mind_gate
	name_ru = "Врата Разума"
	desc_ru = "Наносит вам 20 урона мозгу, а цель оглушает потоком безумия: она может ослепнуть, оглохнуть, онеметь, начать галлюцинировать и потерять рассудок."

/datum/action/cooldown/spell/aoe/moon_ringleader
	name_ru = "Подъём Заводилы"
	desc_ru = "Большое AoE-заклинание, наносящее урон мозгу и вызывающее галлюцинации. Чем ниже рассудок жертв, тем сильнее эффект; уже сломленные цели могут окончательно сойти с ума."

/datum/action/cooldown/lunatic_track
	name_ru = "Лунное Эхо"
	desc_ru = "Позволяет отследить вашего заводилу."

/datum/action/cooldown/spell/pointed/projectile/moon_parade
	name_ru = "Лунный Парад"
	desc_ru = "Запускает процесссию безумия: все на её пути втягиваются в парад и начинают страдать от галлюцинаций."

/datum/action/cooldown/spell/touch/mad_touch
	name_ru = "Прикосновение Безумия"
	desc_ru = "Касание, истощающее рассудок врага и сбивающее его с ног."

/datum/action/cooldown/spell/touch/flesh_surgery
	name_ru = "Сшивание Плоти"
	desc_ru = "Касание, позволяющее вырывать органы из жертвы или, наоборот, восстанавливать плоть и органы союзников и призванных чудовищ."

/datum/action/cooldown/spell/list_target/telepathy/eldritch
	name_ru = "Элдритчская Телепатия"
	desc_ru = "Открывает телепатическую связь с выбранной целью."

/datum/action/cooldown/spell/pointed/manse_link
	name_ru = "Связь Мансе"
	desc_ru = "Пронзает реальность и соединяет разумы между собой, добавляя цель в вашу тайную сеть связи."

/datum/action/cooldown/spell/pointed/blind/eldritch
	name_ru = "Элдритчская Слепота"
	desc_ru = "Направленное заклинание, временно ослепляющее цель силой запретного знания."

/datum/action/cooldown/spell/emp/eldritch
	name_ru = "Энергетический Импульс"
	desc_ru = "Создаёт вокруг вас мощный ЭМИ, выводя из строя ближайшую электронику."

/datum/action/cooldown/spell/pointed/apetra_vulnera
	name_ru = "Apetra Vulnera"
	desc_ru = "Вызывает сильное кровотечение на всех конечностях цели, которые уже имеют серьёзные физические травмы."

/datum/action/cooldown/spell/charged/beam/fire_blast
	name_ru = "Извержение Вулкана"
	desc_ru = "После короткой зарядки выпускает огненный луч, который поджигает цель и может перескочить на ближайших врагов."

/datum/action/cooldown/spell/aoe/fiery_rebirth
	name_ru = "Возрождение Ночного Смотрителя"
	desc_ru = "Гасит пламя на вас и вытягивает жизненную силу из ближайших горящих врагов, исцеляя вас. Чем больше жертв, тем сильнее эффект."

/datum/action/cooldown/spell/wolves_among_sheep
	name_ru = "Волки Среди Овец"
	desc_ru = "Искажает ткань реальности, создавая магическую арену, непроходимую для посторонних. Все внутри получают клинки и не могут уйти, пока не нанесут критический удар."

/datum/action/cooldown/spell/fire_sworn
	name_ru = "Клятва Пламени"
	desc_ru = "На минуту окружает вас кольцом огня, которое будет возникать вокруг вас само по себе."

/datum/action/cooldown/spell/fire_cascade
	name_ru = "Малый Огненный Каскад"
	desc_ru = "Нагревает воздух вокруг вас."

/datum/action/cooldown/spell/fire_cascade/big
	name_ru = "Великий Огненный Каскад"
	desc_ru = "Создаёт куда более мощную волну жара вокруг вас."

/datum/action/cooldown/spell/pointed/ash_beams
	name_ru = "Обряд Ночного Смотрителя"
	desc_ru = "Мощное заклинание, выпускающее в цель пять потоков элдритчского огня."

/datum/action/cooldown/spell/shapeshift/eldritch
	name_ru = "Перевоплощение"
	desc_ru = "Позволяет принять облик другого существа и получить его способности. Повторное применение возвращает вашу прежнюю форму."

/datum/action/cooldown/spell/shapeshift/eldritch/ascension
	name_ru = "Вознесённое Перевоплощение"
	desc_ru = "Позволяет принять форму более могущественного элдритчского существа и временно завладеть его способностями."

/datum/action/cooldown/spell/shapeshift/shed_human_form
	name_ru = "Сбросить Оболочку"
	desc_ru = "Сбрасывает вашу хрупкую человеческую форму, превращая вас в порождение плоти."

/datum/action/cooldown/spell/jaunt/space_crawl
	name_ru = "Космическая Фаза"
	desc_ru = "Позволяет входить и выходить из состояния фазирования в открытом космосе или в наружных зонах с низким давлением."

/datum/action/cooldown/spell/aoe/wave_of_desperation
	name_ru = "Волна Отчаяния"
	desc_ru = "Снимает ваши путы, отбрасывает и валит окружающих, а также накладывает часть эффектов Хватки Мансуса на всё поблизости. Через минуту после применения вы уснёте на 15 секунд."

/datum/action/cancel_crucible_soul
	name_ru = "Отозвать"
	desc_ru = "Позволяет досрочно завершить действие благословения."

/datum/action/cooldown/track_target
	name_ru = "Биение Живого Сердца"
	desc_ru = "ЛКМ: выбрать одну из ваших жертв для отслеживания. ПКМ: повторно выбрать последнюю отмеченную цель."

/datum/action/cooldown/mob_cooldown/replace_star_gazer
	name_ru = "Сброс Сознания Звездочёта"
	desc_ru = "Заменяет разум вашего Звездочёта другим призраком."

/datum/action/item_action/rune_shatter
	name_ru = "Разрушить Руны"
	desc_ru = "Уничтожает все руны, вырезанные этим клинком."

/datum/action/item_action/toggle/flames
	name_ru = "Пламя Доспеха"
	desc_ru = "Включает или выключает пассивное порождение пламени вокруг владельца."

/datum/action/item_action/toggle/gravity
	name_ru = "Нулевая Гравитация"
	desc_ru = "Включает или выключает поддержку движения в невесомости."
